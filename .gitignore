.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*
*.env

# IDE / tooling
.vscode/
.idea/
.claude/

# OS
.DS_Store
Thumbs.db

# web app artifacts
webapp/data/*
